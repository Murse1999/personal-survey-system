# Spring Boot / MySQL
# 正式環境才設定：SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://localhost:3306/personal_quiz_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Taipei&characterEncoding=utf8
DB_USERNAME=root
DB_PASSWORD=

# JWT_SECRET 在正式環境一定要換成長且隨機的密鑰。
JWT_SECRET=change-this-in-production
JWT_EXPIRATION_MS=86400000

# 必須和 Angular 網站的網址相同。
CORS_ALLOWED_ORIGIN=http://localhost:4200

# 雲端平台通常會透過 PORT 環境變數指定埠號。
PORT=8082
